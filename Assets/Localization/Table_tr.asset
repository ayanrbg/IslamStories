  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Table_tr
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: tr
  m_SharedData: {fileID: 11400000, guid: e5e802c0d2b080e4d921feed091eb68f, type: 2}
  m_Metadata:
    m_Items:
    - rid: 1940574370456666166
  m_TableData:
  - m_Id: 42278228537344
    m_Localized: "Ayl\u0131k {value}"
    m_Metadata:
      m_Items:
      - rid: 1940574370456666166
  - m_Id: 41117467488256
    m_Localized: "Dil se\xE7in"
    m_Metadata:
      m_Items: []
  - m_Id: 41219682676736
    m_Localized: Devam et
    m_Metadata:
      m_Items: []
  - m_Id: 41269360013312
    m_Localized: "\xC7ocu\u011Funuz kendi <color=#F7B715>hik\xE2yesinin</color> kahraman\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 41359734681600
    m_Localized: Erkek
    m_Metadata:
      m_Items: []
  - m_Id: 41379049451520
    m_Localized: "K\u0131z"
    m_Metadata:
      m_Items: []
  - m_Id: 41406610223104
    m_Localized: "\xC7ocu\u011Fun ad\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 41470569164800
    m_Localized: "K\xFCt\xFCphane haz\u0131rlan\u0131yor"
    m_Metadata:
      m_Items: []
  - m_Id: 41651758903296
    m_Localized: "Metin ki\u015Fiselle\u015Ftiriliyor..."
    m_Metadata:
      m_Items: []
  - m_Id: 41728770519040
    m_Localized: "Hik\xE2ye y\xFCkleniyor"
    m_Metadata:
      m_Items: []
  - m_Id: 41797116702720
    m_Localized: "T\xFCm kitaplar\u0131n kilidini a\xE7"
    m_Metadata:
      m_Items: []
  - m_Id: 41870852567040
    m_Localized: Oku
    m_Metadata:
      m_Items: []
  - m_Id: 41910010589184
    m_Localized: Seslendir
    m_Metadata:
      m_Items: []
  - m_Id: 41935625203712
    m_Localized: Dinle
    m_Metadata:
      m_Items: []
  - m_Id: 41997755428864
    m_Localized: "3 g\xFCn \xFCcretsiz dene"
    m_Metadata:
      m_Items: []
  - m_Id: 42080202862592
    m_Localized: "Kullan\u0131m ko\u015Fullar\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 42146384785408
    m_Localized: "<u>Sat\u0131n al\u0131mlar\u0131 geri y\xFCkle</u>"
    m_Metadata:
      m_Items: []
  - m_Id: 42204375232512
    m_Localized: "Gizlilik politikas\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 42375049850880
    m_Localized: "Y\u0131ll\u0131k {value}"
    m_Metadata:
      m_Items: []
  - m_Id: 42420583215104
    m_Localized: "Kitab\u0131 seslendir"
    m_Metadata:
      m_Items: []
  - m_Id: 42479991336960
    m_Localized: "Yeni kay\u0131t"
    m_Metadata:
      m_Items: []
  - m_Id: 42528615903232
    m_Localized: "Anlat\u0131c\u0131n\u0131n ad\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 42571360055296
    m_Localized: Taslaklar
    m_Metadata:
      m_Items: []
  - m_Id: 42594013491200
    m_Localized: "Ba\u015Fla"
    m_Metadata:
      m_Items: []
  - m_Id: 42617132494848
    m_Localized: "Kay\u0131t s\xFCr\xFCyor..."
    m_Metadata:
      m_Items: []
  - m_Id: 256430771482624
    m_Localized: "T\xFCm hik\xE2yelere eri\u015Fin!"
    m_Metadata:
      m_Items: []
  - m_Id: 258142592774144
    m_Localized: "Kay\u0131t s\xFCr\xFCyor..."
    m_Metadata:
      m_Items: []
  - m_Id: 261887204470784
    m_Localized: "\u0130\u015Flemi \xE7\xF6z\xFCn"
    m_Metadata:
      m_Items: []
  - m_Id: 262080117288960
    m_Localized: Gizli kod
    m_Metadata:
      m_Items: []
  - m_Id: 8261826526261248
    m_Localized: "\xD6\u011Fretici hik\xE2yeler"
    m_Metadata:
      m_Items: []
  - m_Id: 8261898911559680
    m_Localized: "Her hafta yeni bir hik\xE2ye"
    m_Metadata:
      m_Items: []
  - m_Id: 8261951134838784
    m_Localized: "3 g\xFCn \xFCcretsiz, ard\u0131ndan"
    m_Metadata:
      m_Items: []
  - m_Id: 10851152128847872
    m_Localized: "\u0130\xE7indekiler"
    m_Metadata:
      m_Items: []
  - m_Id: 10854463418609664
    m_Localized: "Yaz\u0131 boyutu"
    m_Metadata:
      m_Items: []
  - m_Id: 11957772317569024
    m_Localized: "Anlat\u0131c\u0131n\u0131n sesini se\xE7in"
    m_Metadata:
      m_Items: []
  - m_Id: 11957940530130944
    m_Localized: "Erkek anlat\u0131c\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 11958034037944320
    m_Localized: "Kad\u0131n anlat\u0131c\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 11958115315167232
    m_Localized: Ebeveyn sesi
    m_Metadata:
      m_Items: []
  - m_Id: 11964739819876352
    m_Localized: "<s>Y\u0131ll\u0131k {value}</s>"
    m_Metadata:
      m_Items: []
  - m_Id: 13396056365281280
    m_Localized: "H\u0131zl\u0131 seslendirme"
    m_Metadata:
      m_Items: []
  - m_Id: 13396145565544448
    m_Localized: "Ebeveyn hik\xE2yeyi kendi sesiyle seslendirebilir; b\xF6ylece \xE7ocuk
      onu istedi\u011Fi zaman, tekrar tekrar dinleyebilir"
    m_Metadata:
      m_Items: []
  - m_Id: 14157788717199360
    m_Localized: Ses kaydedildi
    m_Metadata:
      m_Items: []
  - m_Id: 14157874910146560
    m_Localized: "\xD6nce sesinizi kaydedin \u2014 \u201CSeslendir\u201De dokunun"
    m_Metadata:
      m_Items: []
  - m_Id: 23537650883276800
    m_Localized: Promosyon kodu
    m_Metadata:
      m_Items: []
  - m_Id: 23537745271894016
    m_Localized: Promosyon kodunu girin
    m_Metadata:
      m_Items: []
  - m_Id: 68021238077681664
    m_Localized: "Ad\u0131n\u0131 ekleyin \u2014 \xE7ocu\u011Funuz onu hik\xE2yenin
      i\xE7inde duysun."
    m_Metadata:
      m_Items: []
  - m_Id: 68021238111236096
    m_Localized: Devam et
    m_Metadata:
      m_Items: []
  references:
    version: 2
